{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/\\.env",
      "status": 404
    },
    {
      "src": "/",
      "dest": "/api/index.php?file=index.php"
    },
    {
      "src": "/(.+\\.php)",
      "dest": "/api/index.php?file=$1"
    }
  ]
}
